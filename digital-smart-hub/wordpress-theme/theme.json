{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1160px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#18231f" },
        { "slug": "paper", "name": "Paper", "color": "#f7f6f2" },
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "muted", "name": "Muted", "color": "#6e7771" },
        { "slug": "line", "name": "Fine line", "color": "#dedfd8" },
        { "slug": "brass", "name": "Soft brass", "color": "#a88752" },
        { "slug": "sage", "name": "Sage", "color": "#e8eee8" }
      ],
      "gradients": []
    },
    "spacing": {
      "units": [ "px", "em", "rem", "%", "vw" ],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.75rem" },
        { "slug": "30", "name": "S", "size": "1.25rem" },
        { "slug": "40", "name": "M", "size": "2rem" },
        { "slug": "50", "name": "L", "size": "3.5rem" },
        { "slug": "60", "name": "XL", "size": "5.5rem" }
      ],
      "padding": true,
      "margin": true
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "slug": "sans", "name": "Modern Sans" },
        { "fontFamily": "'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif", "slug": "serif", "name": "Editorial Serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem" },
        { "slug": "x-large", "name": "Display", "size": "clamp(2.75rem, 7vw, 6.5rem)" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "spacing": { "blockGap": "1.25rem" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "16px", "lineHeight": "1.65" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "500", "lineHeight": "1.08", "letterSpacing": "-0.045em" } },
      "link": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "textDecoration": "none" } },
      "button": { "border": { "radius": "2px" }, "color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--white)" }, "typography": { "fontSize": "0.8125rem", "fontWeight": "600", "letterSpacing": "0.04em" }, "spacing": { "padding": { "top": "0.9rem", "right": "1.25rem", "bottom": "0.9rem", "left": "1.25rem" } } }
    },
    "blocks": {
      "core/site-title": { "typography": { "fontSize": "0.875rem", "fontWeight": "700", "letterSpacing": "0.08em", "textTransform": "uppercase" } },
      "core/navigation": { "typography": { "fontSize": "0.8125rem", "fontWeight": "500" } },
      "core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "500" } },
      "core/group": { "spacing": { "blockGap": "1rem" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
